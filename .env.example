APP_NAME=EtosCoach
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_DOMAIN=cmsglobals.test

# Production:
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://app.etoscoach.com
# APP_DOMAIN=etoscoach.com

# Domains that may use session cookies with /api (Sanctum). Include every tenant host.
# SANCTUM_STATEFUL_DOMAINS=app.etoscoach.com,localhost,127.0.0.1
# Optional legacy host remaps (not tenant selection itself):
# TENANT_DOMAIN_ALIASES=old.example.com:app.etoscoach.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12
# DEMO_TENANT_DOMAIN=demo.etoscoach.com

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# System database (tenants table / control plane). Tenant DBs are selected per request.
DB_CONNECTION=system
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cmsglobal
DB_USERNAME=
DB_PASSWORD=
DB_SYSTEM_DATABASE=cmsglobal
# SYSTEM_DB_HOST=
# SYSTEM_DB_PORT=
# SYSTEM_DB_USERNAME=
# SYSTEM_DB_PASSWORD=
# SYSTEM_DB_URL=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@etoscoach.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Web Push (VAPID) — generate keys: php artisan webpush:vapid
# Required by php artisan security:check-secrets
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@etoscoach.com

# Open stock images for meal library review (optional)
# PEXELS_API_KEY=
# UNSPLASH_ACCESS_KEY=

# Stripe (required by security:check-secrets; leave blank only in local if unused)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Paylink
PAYLINK_BASE_URL=https://restapi.paylink.sa
PAYLINK_API_ID=
PAYLINK_SECRET_KEY=
PAYLINK_PERSIST_TOKEN=true
PAYLINK_WEBHOOK_SECRET=
PAYLINK_CALLBACK_URL=https://app.etoscoach.com/billing/paylink/callback
PAYLINK_CANCEL_URL=https://app.etoscoach.com/subscribe
PAYLINK_WEBHOOK_URL=https://app.etoscoach.com/webhooks/paylink
PAYLINK_CURRENCY=SAR
PAYLINK_SUPPORTED_CARD_BRANDS=mada,visaMastercard,stcpay

# Required in production for webhook signature verification
COMMUNICATION_WEBHOOK_SECRET=

# WhatsApp OTP (Twilio)
# Local: WHATSAPP_DRIVER=log + WHATSAPP_OTP_DEBUG=true
# Production: WHATSAPP_DRIVER=twilio + Twilio credentials, WHATSAPP_OTP_DEBUG=false
WHATSAPP_DRIVER=log
WHATSAPP_OTP_DEBUG=true
WHATSAPP_OTP_TTL=300
WHATSAPP_OTP_RESEND_SECONDS=60
# TWILIO_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
